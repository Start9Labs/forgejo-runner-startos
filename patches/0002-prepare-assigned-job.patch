+func TestBeforeJobDefersDockerAvailability(t *testing.T) {
+	t.Setenv("DOCKER_HOST", "")
+	cfg := &config.Config{}
+	cfg.Container.DockerHost = "unix:///nonexistent/deferred-job-docker.sock"
+	cfg.Server.Connections = map[string]*config.Connection{
+		"fixture": {Labels: labels.Labels{&labels.Label{Name: "fixture", Schema: labels.SchemeDocker, Arg: "//alpine"}}},
+	}
+	cfg.Runner.BeforeJob = []string{"/trusted/prepare"}
+	require.NoError(t, configCheck(t.Context(), cfg))
+	cfg.Runner.BeforeJob = nil
+	require.Error(t, configCheck(t.Context(), cfg))
+}
+
+func TestBeforeJobPreservesRemoteEndpointNormalization(t *testing.T) {
+	endpoint := "tcp://127.0.0.1:23750"
+	t.Setenv("DOCKER_HOST", "")
+	cfg := &config.Config{}
+	cfg.Container.DockerHost = endpoint
+	cfg.Server.Connections = map[string]*config.Connection{
+		"fixture": {Labels: labels.Labels{{Name: "fixture", Schema: labels.SchemeDocker, Arg: "//alpine"}}},
+	}
+	cfg.Runner.BeforeJob = []string{"/trusted/prepare"}
+	require.NoError(t, configCheck(t.Context(), cfg))
+	require.Equal(t, endpoint, os.Getenv("DOCKER_HOST"))
+	require.Equal(t, "-", cfg.Container.DockerHost)
+}
