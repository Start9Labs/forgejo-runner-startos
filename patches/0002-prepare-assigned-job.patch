diff --git a/internal/app/run/before_job.go b/internal/app/run/before_job.go
new file mode 100644
index 00000000..0cff96d8
--- /dev/null
+++ b/internal/app/run/before_job.go
@@ -0,0 +1,31 @@
+package run
+
+import (
+	"context"
+	"io"
+	"os/exec"
+	"strings"
+	"time"
+
+	"code.forgejo.org/forgejo/runner/v13/internal/pkg/report"
+)
+
+type preparationLog struct {
+	reporter *report.Reporter
+}
+
+func (w preparationLog) Write(p []byte) (int, error) {
+	w.reporter.Logf("%s", strings.TrimSuffix(string(p), "\n"))
+	return len(p), nil
+}
+
+func runBeforeJob(ctx context.Context, command []string, output io.Writer) error {
+	if len(command) == 0 {
+		return nil
+	}
+	cmd := exec.CommandContext(ctx, command[0], command[1:]...)
+	cmd.Stdout = output
+	cmd.Stderr = output
+	cmd.WaitDelay = 5 * time.Second
+	return cmd.Run()
+}
diff --git a/internal/app/run/before_job_test.go b/internal/app/run/before_job_test.go
new file mode 100644
index 00000000..d00bf263
--- /dev/null
+++ b/internal/app/run/before_job_test.go
@@ -0,0 +1,37 @@
+package run
+
+import (
+	"bytes"
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestBeforeJobPreparation(t *testing.T) {
+	t.Run("absent hook", func(t *testing.T) {
+		require.NoError(t, runBeforeJob(t.Context(), nil, &bytes.Buffer{}))
+	})
+	t.Run("completion precedes execution", func(t *testing.T) {
+		marker := filepath.Join(t.TempDir(), "prepared")
+		var output bytes.Buffer
+		require.NoError(t, runBeforeJob(t.Context(), []string{"sh", "-ec", "printf ready; printf done > \"$1\"", "hook", marker}, &output))
+		data, err := os.ReadFile(marker)
+		require.NoError(t, err)
+		require.Equal(t, "done", string(data))
+		require.Equal(t, "ready", output.String())
+	})
+	t.Run("failed provisioning fails job", func(t *testing.T) {
+		require.Error(t, runBeforeJob(t.Context(), []string{"sh", "-c", "exit 7"}, &bytes.Buffer{}))
+	})
+	t.Run("cancellation interrupts provisioning", func(t *testing.T) {
+		ctx, cancel := context.WithCancel(t.Context())
+		cancel()
+		start := time.Now()
+		require.Error(t, runBeforeJob(ctx, []string{"sleep", "60"}, &bytes.Buffer{}))
+		require.Less(t, time.Since(start), time.Second)
+	})
+}
