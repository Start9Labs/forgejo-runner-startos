@@ -0,0 +1,17 @@
+package config
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestBeforeJobConfiguration(t *testing.T) {
+	cfg := &Config{}
+	settings := serializedRunnerSettings{BeforeJob: []string{"/trusted/prepare", "argument"}}
+	require.NoError(t, settings.applyTo(cfg))
+	require.Equal(t, settings.BeforeJob, cfg.Runner.BeforeJob)
+	settings.BeforeJob[0] = "changed"
+	require.Equal(t, "/trusted/prepare", cfg.Runner.BeforeJob[0])
+	require.Error(t, (&serializedRunnerSettings{BeforeJob: []string{""}}).applyTo(cfg))
+}
