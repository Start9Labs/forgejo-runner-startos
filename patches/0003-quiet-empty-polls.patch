Subject: [PATCH] Log empty single-task polls at debug level

Retire when upstream logs routine empty single-task polls below info level.

diff --git a/internal/app/poll/single.go b/internal/app/poll/single.go
index 567e3058..3f845e95 100644
--- a/internal/app/poll/single.go
+++ b/internal/app/poll/single.go
@@ -107,7 +107,7 @@ func (s *singleTaskPoller) Poll() error {
 			requestKey = gouuid.New()
 		}
 		if task == nil && s.wait {
-			log.Infof("single task poller received no task from %s, trying again", s.client.Address())
+			log.Debugf("single task poller received no task from %s, trying again", s.client.Address())
 			continue
 		}
 
