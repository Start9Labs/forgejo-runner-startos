 func TestSingleTaskPoller_WaitsForAvailableTask(t *testing.T) {
+	var output bytes.Buffer
+	logger := log.StandardLogger()
+	previousOutput, previousLevel := logger.Out, logger.GetLevel()
+	logger.SetOutput(&output)
+	logger.SetLevel(log.InfoLevel)
+	t.Cleanup(func() {
+		logger.SetOutput(previousOutput)
+		logger.SetLevel(previousLevel)
+	})
 	cfg := &config.Config{}
 
 	mockClient := mock_client.NewMockClient(t)
@@ -76,6 +87,8 @@ func TestSingleTaskPoller_WaitsForAvailableTask(t *testing.T) {
 	taskPoller := NewSingleTaskPoller(t.Context(), cfg, mockClient, mockRunner, true, nil)
 	err := taskPoller.Poll()
 	require.NoError(t, err)
+	require.NotContains(t, output.String(), "received no task")
+	require.Contains(t, output.String(), "successfully fetched one task")
 }
 
