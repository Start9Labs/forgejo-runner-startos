+func newJobActionCache(parent string) (string, error) {
+	if parent != "" {
+		var err error
+		parent, err = filepath.Abs(filepath.FromSlash(parent))
+		if err != nil {
+			return "", err
+		}
+		if err := os.MkdirAll(parent, 0o700); err != nil {
+			return "", err
+		}
+	}
+	return os.MkdirTemp(parent, "forgejo-runner-actions-")
+}
