diff --git a/act/runner/action_source_test.go b/act/runner/action_source_test.go
new file mode 100644
index 00000000..05ba04e3
--- /dev/null
+++ b/act/runner/action_source_test.go
@@ -0,0 +1,100 @@
+package runner
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"code.forgejo.org/forgejo/runner/v13/act/model"
+	"github.com/stretchr/testify/require"
+)
+
+func TestRemoteActionSourceBoundary(t *testing.T) {
+	for _, test := range []struct {
+		name                string
+		readLink, writeLink bool
+	}{
+		{name: "normal metadata"},
+		{name: "metadata outside source", readLink: true},
+		{name: "fallback outside source", writeLink: true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			base := t.TempDir()
+			repo := filepath.Join(base, "repo")
+			dir := filepath.Join(repo, "action")
+			require.NoError(t, os.MkdirAll(dir, 0o700))
+			outside := filepath.Join(base, "fixture")
+			metadata := []byte("name: fixture\nruns:\n  using: node20\n  main: index.js\n")
+			require.NoError(t, os.WriteFile(outside, metadata, 0o600))
+			if test.readLink {
+				require.NoError(t, os.Symlink(outside, filepath.Join(dir, "action.yml")))
+			} else if test.writeLink {
+				require.NoError(t, os.Symlink(outside, filepath.Join(dir, "trampoline.js")))
+			} else {
+				require.NoError(t, os.WriteFile(filepath.Join(dir, "action.yml"), metadata, 0o600))
+			}
+			sar := &stepActionRemote{
+				Step: &model.Step{Uses: "org/repo/action@v1", With: map[string]string{"args": "echo fixture"}},
+				RunContext: &RunContext{
+					Config: &Config{},
+					Run:    &model.Run{JobID: "1", Workflow: &model.Workflow{Jobs: map[string]*model.Job{"1": {}}}},
+				},
+				workTree:   &dirWorktree{dir: repo},
+				readAction: readActionImpl,
+			}
+			err := sar.prepareActionExecutor()(t.Context())
+			if test.readLink || test.writeLink {
+				require.Error(t, err)
+			} else {
+				require.NoError(t, err)
+			}
+			content, err := os.ReadFile(outside)
+			require.NoError(t, err)
+			require.Equal(t, metadata, content)
+		})
+	}
+}
+
+func TestRemoteActionBuildContext(t *testing.T) {
+	base := t.TempDir()
+	repo := filepath.Join(base, "repo")
+	outside := filepath.Join(base, "repo-sibling")
+	for _, dir := range []string{repo, outside, filepath.Join(repo, "actions", "example")} {
+		require.NoError(t, os.MkdirAll(dir, 0o700))
+		require.NoError(t, os.WriteFile(filepath.Join(dir, "Dockerfile"), []byte("FROM scratch\n"), 0o600))
+	}
+	require.NoError(t, os.WriteFile(filepath.Join(repo, "actions", "Dockerfile"), []byte("FROM scratch\n"), 0o600))
+	require.NoError(t, os.Symlink(outside, filepath.Join(repo, "outside-dir")))
+	require.NoError(t, os.Symlink(filepath.Join(outside, "Dockerfile"), filepath.Join(repo, "outside-file")))
+	require.NoError(t, os.Symlink("actions", filepath.Join(repo, "inside-dir")))
+
+	for _, test := range []struct {
+		name, actionPath, image, context string
+		invalid                          bool
+	}{
+		{name: "root", image: "Dockerfile", context: repo},
+		{name: "nested", actionPath: "actions/example", image: "Dockerfile", context: filepath.Join(repo, "actions", "example")},
+		{name: "repository parent", actionPath: "actions/example", image: "../Dockerfile", context: filepath.Join(repo, "actions")},
+		{name: "inside directory symlink", image: "inside-dir/Dockerfile", context: filepath.Join(repo, "actions")},
+		{name: "parent escape", image: "../repo-sibling/Dockerfile", invalid: true},
+		{name: "action path escape", actionPath: "../repo-sibling", image: "Dockerfile", invalid: true},
+		{name: "absolute image", image: filepath.Join(outside, "Dockerfile"), invalid: true},
+		{name: "absolute action", actionPath: outside, image: "Dockerfile", invalid: true},
+		{name: "directory symlink escape", image: "outside-dir/Dockerfile", invalid: true},
+		{name: "file symlink escape", image: "outside-file", invalid: true},
+		{name: "directory instead of file", image: "actions", invalid: true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			context, file, err := remoteActionBuildContext(repo, test.actionPath, test.image)
+			if test.invalid {
+				require.Error(t, err)
+				return
+			}
+			require.NoError(t, err)
+			expected, err := filepath.EvalSymlinks(test.context)
+			require.NoError(t, err)
+			require.Equal(t, expected, context)
+			require.Equal(t, "Dockerfile", file)
+		})
+	}
+}
