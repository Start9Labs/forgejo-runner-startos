+func remoteActionBuildContext(sourceDir, actionPath, image string) (string, string, error) {
+	name := filepath.Join(actionPath, image)
+	if filepath.IsAbs(actionPath) || filepath.IsAbs(image) || !filepath.IsLocal(name) {
+		return "", "", fmt.Errorf("Docker action image must stay within its source repository")
+	}
+	source, err := os.OpenRoot(sourceDir)
+	if err != nil {
+		return "", "", err
+	}
+	defer source.Close()
+	file, err := source.Open(name)
+	if err != nil {
+		return "", "", fmt.Errorf("invalid Docker action source: %w", err)
+	}
+	info, err := file.Stat()
+	file.Close()
+	if err != nil {
+		return "", "", err
+	}
+	if !info.Mode().IsRegular() {
+		return "", "", fmt.Errorf("Docker action image must name a regular file")
+	}
+	sourceDir, err = filepath.EvalSymlinks(sourceDir)
+	if err != nil {
+		return "", "", err
+	}
+	contextDir, err := filepath.EvalSymlinks(filepath.Join(sourceDir, filepath.Dir(name)))
+	if err != nil {
+		return "", "", err
+	}
+	rel, err := filepath.Rel(sourceDir, contextDir)
+	if err != nil || !filepath.IsLocal(rel) {
+		return "", "", fmt.Errorf("Docker action context must stay within its source repository")
+	}
+	return contextDir, filepath.Base(name), nil
+}
