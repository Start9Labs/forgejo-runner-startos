diff --git a/act/container/docker/build_context_test.go b/act/container/docker/build_context_test.go
new file mode 100644
index 00000000..ba0c1230
--- /dev/null
+++ b/act/container/docker/build_context_test.go
@@ -0,0 +1,51 @@
+//go:build !WITHOUT_DOCKER && (linux || darwin || windows || freebsd || openbsd)
+
+package docker
+
+import (
+	"archive/tar"
+	"io"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestBuildContextIgnoreFileBoundary(t *testing.T) {
+	for _, linked := range []bool{false, true} {
+		t.Run(map[bool]string{false: "regular", true: "outside symlink"}[linked], func(t *testing.T) {
+			base := t.TempDir()
+			contextDir := filepath.Join(base, "context")
+			require.NoError(t, os.Mkdir(contextDir, 0o700))
+			require.NoError(t, os.WriteFile(filepath.Join(contextDir, "Dockerfile"), []byte("FROM scratch\n"), 0o600))
+			if linked {
+				outside := filepath.Join(base, "ignore")
+				require.NoError(t, os.WriteFile(outside, []byte("unused\n"), 0o600))
+				require.NoError(t, os.Symlink(outside, filepath.Join(contextDir, ".dockerignore")))
+			} else {
+				require.NoError(t, os.WriteFile(filepath.Join(contextDir, ".dockerignore"), []byte("unused\n"), 0o600))
+			}
+			stream, err := createBuildContext(t.Context(), contextDir, "Dockerfile")
+			if linked {
+				require.Error(t, err)
+				return
+			}
+			require.NoError(t, err)
+			defer stream.Close()
+			reader := tar.NewReader(stream)
+			found := false
+			for {
+				header, err := reader.Next()
+				if err == io.EOF {
+					break
+				}
+				require.NoError(t, err)
+				if header.Name == "Dockerfile" {
+					found = true
+				}
+			}
+			require.True(t, found)
+		})
+	}
+}
